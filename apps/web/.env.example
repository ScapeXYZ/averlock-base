# Select staging (Base Sepolia) or production (Base Mainnet). Local development
# defaults to staging when this is unset.
NEXT_PUBLIC_AVERLOCK_ENV=staging

# Public RPC overrides. Never put wallet secrets here.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=https://mainnet.base.org
# Optional AVERLOCK-only event history service. Dashboard/guards/vault contract reads
# still work when this is unset or the indexer is catching up.
NEXT_PUBLIC_AVERLOCK_INDEXER_URL=
