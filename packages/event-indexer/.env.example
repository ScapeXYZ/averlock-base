AVERLOCK_RPC_URL=https://sepolia.base.org
# Comma-separated contract addresses. GuardManager must be first; ProtectionVault second.
AVERLOCK_CONTRACT_ADDRESSES=0xB2d5B8a9dF91466F07fcBA92f334cb143197151d,0x5f7a95160A34e84B91e25903b69B8B378094a9B0
AVERLOCK_CHAIN_ID=84532
AVERLOCK_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
AVERLOCK_V2_FACTORY_ADDRESS=0x355c5ECB31EA54092f56263c591B44f156B325C5
AVERLOCK_V2_VAULT_ADDRESS=0x914Eb41bE452f192e822c82ed83cC2CEAf3c3D23
AVERLOCK_V2_START_BLOCK=45527065
# The deployment block of the earliest configured AVERLOCK contract.
AVERLOCK_START_BLOCK=45438094
# Durable Railway volume path for the SQLite database.
AVERLOCK_INDEXER_DB_PATH=/data/averlock-events.sqlite
PORT=8080
# The indexer only serves blocks this far behind the head to withstand short reorgs.
AVERLOCK_CONFIRMATIONS=12
AVERLOCK_REORG_OVERLAP=24
AVERLOCK_LOG_BLOCK_RANGE=2000
# Global limit for every Base JSON-RPC request, including eth_blockNumber.
AVERLOCK_RPC_REQUESTS_PER_SECOND=2
